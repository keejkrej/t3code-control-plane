# Public origin of the deployment; also the connect-token issuer. Defaults to
# https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel and http://localhost:3000 in development.
CONTROL_PLANE_URL=http://localhost:3000

# Neon/Postgres connection string, or `pglite:<dir>` / `pglite:memory` for local development.
DATABASE_URL=pglite:.data/pglite

# Sign in with Vercel (OAuth app). Callback URL: $CONTROL_PLANE_URL/api/auth/callback
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# Generate both with `npm run keygen`.
SESSION_SECRET=
CONNECT_TOKEN_SIGNING_KEY=

# Optional: JSON array of retired public keys ([{"x":"…"}]) kept in the JWKS during rotation.
CONNECT_TOKEN_RETIRED_KEYS=

# Optional: comma-separated Vercel user IDs, usernames, or emails allowed to sign in.
ALLOWED_USERS=
